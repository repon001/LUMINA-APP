enum ExpenseCategory {
  TRANSPORT
  ACCOMMODATION
  FOOD
  ACTIVITIES
  SHOPPING
  FEES
  OTHER
}

/// Money actually spent on a trip, as opposed to the budget planned for it.
model Expense {
  id       String @id @default(cuid())
  tripId   String
  /// Who paid. Kept for a future split between collaborators.
  paidById String

  amount Decimal @db.Decimal(12, 2)
  /// Expenses are recorded in the currency they were paid in, not converted on
  /// the way in: a rate applied at write time freezes a guess into the record.
  currencyCode String @db.Char(3)

  category ExpenseCategory @default(OTHER)
  title    String
  notes    String?

  /// The day the money went out, not the instant it was typed in.
  spentAt DateTime @db.Date

  /// Optional link to what it was spent on.
  placeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy User   @relation(fields: [paidById], references: [id], onDelete: Restrict)
  place  Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([tripId, spentAt])
  @@index([tripId, category])
  @@index([paidById])
  @@index([placeId])
}
