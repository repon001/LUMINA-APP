/// A city or region a trip can be built around.
model Destination {
  id          String  @id @default(cuid())
  /// URL-friendly identifier, e.g. "tokyo-jp". Clients may fetch by it.
  slug        String  @unique
  name        String
  country     String
  /// ISO 3166-1 alpha-2, e.g. "JP".
  countryCode String  @db.Char(2)
  description String?

  /// Decimal, not Float: coordinates are compared and indexed, and a binary
  /// float would make two "identical" points differ in the last place.
  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  /// IANA zone, e.g. "Asia/Tokyo". Used to render local times.
  timezone      String?
  /// ISO 4217, e.g. "JPY".
  currencyCode  String? @db.Char(3)
  coverImageUrl String?
  tags          String[]

  isFeatured Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Public listings show APPROVED only. See moderation.prisma.
  status        ModerationStatus @default(PENDING)
  submittedById String?
  reviewedById  String?
  reviewedAt    DateTime?
  /// Why it was turned down. Shown to whoever submitted it.
  reviewNote    String?

  places    Place[]
  tripStops TripStop[]
  images    CatalogueImage[]

  /// SetNull, not Cascade: a deleted account must not take the city it
  /// contributed down with it.
  submittedBy User? @relation("DestinationSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User? @relation("DestinationReviews", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([countryCode])
  @@index([isFeatured, isActive])
  // Serves the moderation queue: oldest pending first.
  @@index([status, createdAt])
  @@index([submittedById])
  // Serves the bounding-box scan behind "destinations near me".
  @@index([latitude, longitude])
}
