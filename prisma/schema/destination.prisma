/// A city or region a trip can be built around.
model Destination {
  id          String  @id @default(cuid())
  /// URL-friendly identifier, e.g. "tokyo-jp". Clients may fetch by it.
  slug        String  @unique
  name        String
  country     String
  /// ISO 3166-1 alpha-2, e.g. "JP".
  countryCode String  @db.Char(2)
  description String?

  /// Decimal, not Float: coordinates are compared and indexed, and a binary
  /// float would make two "identical" points differ in the last place.
  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  /// IANA zone, e.g. "Asia/Tokyo". Used to render local times.
  timezone      String?
  /// ISO 4217, e.g. "JPY".
  currencyCode  String? @db.Char(3)
  coverImageUrl String?
  tags          String[]

  isFeatured Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  places    Place[]
  tripStops TripStop[]

  @@index([countryCode])
  @@index([isFeatured, isActive])
  // Serves the bounding-box scan behind "destinations near me".
  @@index([latitude, longitude])
}
