enum PaymentProvider {
  STRIPE
  SSLCOMMERZ
  /// Local-only provider used when no gateway keys are configured.
  STUB
}

enum PaymentStatus {
  /// Created, checkout handed to the customer, nothing confirmed yet.
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentPurpose {
  /// Booking a hotel, restaurant or activity from the catalogue.
  BOOKING
  /// Paying for a whole trip package.
  TRIP_PACKAGE
  SUBSCRIPTION
  OTHER
}

model Payment {
  id     String  @id @default(cuid())
  userId String
  tripId String?
  /// What is being paid for, when it is a catalogue item.
  placeId String?

  provider PaymentProvider
  purpose  PaymentPurpose  @default(BOOKING)
  status   PaymentStatus   @default(PENDING)

  amount       Decimal @db.Decimal(12, 2)
  currencyCode String  @db.Char(3)
  description  String

  /// Our id, sent to the gateway and echoed back, which is how a webhook finds
  /// this row. Unique so a replayed callback can never touch two payments.
  reference String @unique
  /// The gateway's own id for the session or transaction.
  providerRef String?

  checkoutUrl   String?
  paidAt        DateTime?
  failureReason String?

  /// Whatever the gateway sent back, kept verbatim for support and disputes.
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip  Trip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([tripId])
  @@index([providerRef])
}
