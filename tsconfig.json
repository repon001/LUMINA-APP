{
  "compilerOptions": {
    /* Language and environment */
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    /* package.json has no "type": "module", so nodenext emits CommonJS. */
    "module": "nodenext",
    "moduleResolution": "nodenext",

    /* Emit. rootDir lives in tsconfig.prod.json: this config also type-checks
       tests/, which sit outside src/. */
    "outDir": "./dist",
    "sourceMap": true,

    /* Interop */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    /* Type checking */
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
