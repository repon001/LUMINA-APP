# ---- Server ----
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# The schema this app owns. Must match the ?schema= above. Set it to something
# other than "public" when the database is shared with another application.
DATABASE_SCHEMA=public

# Only needed when DATABASE_URL points at a connection pooler (Neon, Supabase,
# PgBouncer). Migrations need a direct session for DDL and advisory locks, which
# a pooler in transaction mode cannot provide. Same credentials, unpooled host.
# DIRECT_URL="postgresql://user:pass@db.direct-host/dbname?sslmode=require"

# ---- Auth ----
# Use long random values in production, e.g. `openssl rand -hex 48`.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_me_with_a_long_random_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Send the refresh cookie only over HTTPS. Keep false for local http dev.
COOKIE_SECURE=false

# ---- Rate limiting ----
# Window length in minutes, and max requests per window per IP.
RATE_TIME_LIMIT=15
RATE_REQUEST_LIMIT=100

# ---- Seed ----
# Password given to every seeded account. Development only.
# SEED_PASSWORD=Password123!
