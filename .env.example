# ---- Server ----
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed origins for CORS.
#
# Only browsers enforce this - a native app ignores it entirely. For Expo web,
# list every port the dev server may claim (8081 is the default, but it moves to
# 8082+ when taken) and the LAN address as well as localhost, because the page
# can be opened by either. A blocked origin surfaces in the app as a failed
# fetch - "No connection" - not as a CORS message.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082

# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# The schema this app owns. Must match the ?schema= above. Set it to something
# other than "public" when the database is shared with another application.
DATABASE_SCHEMA=public

# Only needed when DATABASE_URL points at a connection pooler (Neon, Supabase,
# PgBouncer). Migrations need a direct session for DDL and advisory locks, which
# a pooler in transaction mode cannot provide. Same credentials, unpooled host.
# DIRECT_URL="postgresql://user:pass@db.direct-host/dbname?sslmode=require"

# ---- Auth ----
# Use long random values in production, e.g. `openssl rand -hex 48`.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_me_with_a_long_random_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Send the refresh cookie only over HTTPS. Keep false for local http dev.
COOKIE_SECURE=false

# ---- Rate limiting ----
# Window length in minutes, and max requests per window per IP.
RATE_TIME_LIMIT=15
RATE_REQUEST_LIMIT=100

# ---- Seed ----
# Password given to every seeded account. Development only.
# SEED_PASSWORD=Password123!

# ---- Payments ----
# Where gateways send customers back and call webhooks. Must be reachable from
# the internet for real callbacks - use a tunnel (ngrok, cloudflared) locally.
PUBLIC_BASE_URL=http://localhost:4000
PAYMENT_SUCCESS_URL=http://localhost:3000/payments/success
PAYMENT_CANCEL_URL=http://localhost:3000/payments/cancel

# Stripe. The webhook secret comes from `stripe listen` or the dashboard.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# SSLCommerz. Sandbox credentials come from the sandbox portal.
# SSLCOMMERZ_STORE_ID=yourstore
# SSLCOMMERZ_STORE_PASSWORD=yourstorepass
SSLCOMMERZ_SANDBOX=true

# The stub gateway settles payments locally, for development only.
PAYMENT_ALLOW_STUB=true

# ---- AI (OpenRouter) ----
# OPENROUTER_API_KEY=sk-or-v1-...
# Any model id OpenRouter serves. Cheaper alternatives: anthropic/claude-haiku-4.5,
# google/gemini-2.5-flash, meta-llama/llama-3.3-70b-instruct.
OPENROUTER_MODEL=anthropic/claude-opus-5
OPENROUTER_TIMEOUT_MS=90000
# off | low | medium | high. Reasoning improves plans on models that support it,
# but comes out of the same token budget as the answer.
OPENROUTER_REASONING=off
# AI requests per window per user (they cost money on every call).
AI_RATE_REQUEST_LIMIT=20
